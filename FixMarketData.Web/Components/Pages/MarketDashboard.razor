@implements IAsyncDisposable
@inject IConfiguration Configuration

<div class="dashboard-shell">
    <div class="dashboard-header">
        <div>
            <h1 class="mb-1">Market Data Dashboard</h1>
            <p class="dashboard-subtitle mb-0">Live quotes streamed from SignalR feed</p>
        </div>
        <div class="dashboard-meta">
            <span class="badge text-bg-light border">@_ticks.Count symbols</span>
            <small class="text-muted">@GetLastUpdateLabel()</small>
        </div>
    </div>

    @if (_connectionError is not null)
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            @_connectionError
        </div>
    }

    <div class="table-responsive border rounded shadow-sm">
        <table class="table table-striped table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Symbol</th>
                    <th>Bid</th>
                    <th>Ask</th>
                    <th>Bid Size</th>
                    <th>Ask Size</th>
                    <th>Timestamp (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @if (_ticks.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4"><em>Waiting for market data...</em></td>
                    </tr>
                }
                else
                {
                    @foreach (var row in _ticks.Values.OrderBy(t => t.Symbol))
                    {
                        <tr>
                            <td class="fw-semibold">@row.Symbol</td>
                            <td class="@GetTrendClass(row.BidTrend)">@row.BidPrice.ToString("0.00000")</td>
                            <td class="@GetTrendClass(row.AskTrend)">@row.AskPrice.ToString("0.00000")</td>
                            <td>@row.BidSize.ToString("0.00000")</td>
                            <td>@row.AskSize.ToString("0.00000")</td>
                            <td class="text-nowrap">@row.Timestamp.ToString("HH:mm:ss.fff")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private readonly Dictionary<string, TickViewModel> _ticks = [];
    private HubConnection? _hubConnection;
    private string? _connectionError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var backendBaseUrl = Configuration["BackendBaseUrl"] ?? "https://localhost:7544";
            var candidateHubUrls = BuildCandidateHubUrls(backendBaseUrl);

            Exception? lastException = null;
            const int maxAttempts = 30;

            for (var attempt = 1; attempt <= maxAttempts; attempt++)
            {
                foreach (var hubUrl in candidateHubUrls)
                {
                    _hubConnection = new HubConnectionBuilder()
                        .WithUrl(hubUrl)
                        .WithAutomaticReconnect()
                        .Build();

                    _hubConnection.On<MarketDataTick>("ReceiveMarketData", tick =>
                    {
                        _ = InvokeAsync(() =>
                        {
                            try
                            {
                                ApplyTick(tick);
                                StateHasChanged();
                            }
                            catch (Exception ex)
                            {
                                _connectionError = $"Market data update failed: {ex.Message}";
                            }
                        });
                    });

                    try
                    {
                        await _hubConnection.StartAsync();
                        _connectionError = null;
                        return;
                    }
                    catch (Exception ex)
                    {
                        lastException = ex;
                        await _hubConnection.DisposeAsync();
                        _hubConnection = null;
                    }
                }

                _connectionError = $"Unable to connect to backend SignalR hub yet. Retrying... ({attempt}/{maxAttempts})";
                await Task.Delay(1000);
            }

            _connectionError = $"Unable to connect to backend SignalR hub. Tried: {string.Join(", ", candidateHubUrls.Select(u => u.ToString()))}";
            if (lastException is not null)
            {
                Console.WriteLine(lastException);
            }
        }
        catch (Exception ex)
        {
            _connectionError = $"Dashboard initialization failed: {ex.Message}";
            Console.WriteLine(ex);
        }
    }

    private static IReadOnlyList<Uri> BuildCandidateHubUrls(string backendBaseUrl)
    {
        var configuredBaseUri = new Uri(backendBaseUrl, UriKind.Absolute);
        var configuredHubUri = new Uri(configuredBaseUri, "/marketDataHub");

        var candidates = new List<Uri> { configuredHubUri };

        if (configuredBaseUri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase) &&
            configuredBaseUri.Port == 7544)
        {
            candidates.Add(new Uri("http://localhost:5491/marketDataHub"));
        }

        return candidates
            .GroupBy(u => u.AbsoluteUri, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private void ApplyTick(MarketDataTick tick)
    {
        if (tick is null)
        {
            return;
        }

        var symbol = tick.Symbol?.Trim();
        if (string.IsNullOrWhiteSpace(symbol))
        {
            return;
        }

        if (_ticks.TryGetValue(symbol, out var existing))
        {
            existing.BidTrend = tick.BidPrice > existing.BidPrice ? PriceTrend.Up : tick.BidPrice < existing.BidPrice ? PriceTrend.Down : PriceTrend.None;
            existing.AskTrend = tick.AskPrice > existing.AskPrice ? PriceTrend.Up : tick.AskPrice < existing.AskPrice ? PriceTrend.Down : PriceTrend.None;
            existing.BidPrice = tick.BidPrice;
            existing.AskPrice = tick.AskPrice;
            existing.BidSize = tick.BidSize;
            existing.AskSize = tick.AskSize;
            existing.Timestamp = tick.Timestamp;
            return;
        }

        _ticks[symbol] = new TickViewModel
        {
            Symbol = symbol,
            BidPrice = tick.BidPrice,
            AskPrice = tick.AskPrice,
            BidSize = tick.BidSize,
            AskSize = tick.AskSize,
            Timestamp = tick.Timestamp,
            BidTrend = PriceTrend.None,
            AskTrend = PriceTrend.None
        };
    }

    private string GetLastUpdateLabel()
    {
        if (_ticks.Count == 0)
        {
            return "Waiting for first update";
        }

        var latestTimestamp = _ticks.Values.Max(t => t.Timestamp);
        return $"Last update: {latestTimestamp:HH:mm:ss.fff} UTC";
    }

    private static string GetTrendClass(PriceTrend trend) => trend switch
    {
        PriceTrend.Up => "price-up",
        PriceTrend.Down => "price-down",
        _ => string.Empty
    };

    private enum PriceTrend
    {
        None,
        Up,
        Down
    }

    private sealed class TickViewModel
    {
        public string Symbol { get; set; } = string.Empty;
        public decimal BidPrice { get; set; }
        public decimal AskPrice { get; set; }
        public decimal BidSize { get; set; }
        public decimal AskSize { get; set; }
        public DateTime Timestamp { get; set; }
        public PriceTrend BidTrend { get; set; }
        public PriceTrend AskTrend { get; set; }
    }
}